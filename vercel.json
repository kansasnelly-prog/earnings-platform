{
  "rewrites": [
    {
      "source": "/api/send-telegram-notification",
      "destination": "/api/send-telegram-notification.js"
    },
    {
      "source": "/api/telegram-router",
      "destination": "/api/telegram-router.js"
    },
    {
      "source": "/api/admin-customer-service",
      "destination": "/api/admin-customer-service.js"
    },
    {
      "source": "/api/admin-users",
      "destination": "/api/admin-users.js"
    },
    {
      "source": "/api/training-management",
      "destination": "/api/training-management.js"
    },
    {
      "source": "/((?!api|assets|.*\\.js|.*\\.css|.*\\.woff|.*\\.woff2|.*\\.ttf|.*\\.otf|.*\\.eot|.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.svg|.*\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "authorization, x-client-info, apikey, content-type"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
